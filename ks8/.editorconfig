# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

# 2 space indentation for YAML files (commonly used for Kubernetes configs)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# 2 space indentation for Terraform files
[*.tf]
indent_style = space
indent_size = 2

# 4 space indentation for JSON files
[*.json]
indent_style = space
indent_size = 4

# Ensure .tfstate files are treated as binary
[*.tfstate]
charset = binary
